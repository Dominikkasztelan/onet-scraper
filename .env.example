# Tor Configuration
# Default is localhost:9050 for local Tor, or 'tor:9050' for Docker Compose
TOR_PROXY=socks5://127.0.0.1:9050
TOR_CONTROL_PORT=9051
TOR_PASSWORD=
# Set to True when Tor is running on the server (False = direct connection for local testing)
TOR_ENABLED=False

# Database Configuration
# SQLite (default, zero-config): sqlite:///data/articles.db
# PostgreSQL (production):        postgresql://user:password@localhost:5432/scraper
DATABASE_URL=sqlite:///data/articles.db

# Docker PostgreSQL password (used in docker-compose.yml)
DB_PASSWORD=scraper_dev

# Scraper Configuration
LOG_LEVEL=INFO
